# Optional. 1Click partner JWT from https://partners.near-intents.org
# Server-side only (sent as Authorization: Bearer from API routes). Never prefix it with NEXT_PUBLIC_.
# Without it quotes still work, but 1Click adds a 0.25% platform fee.
ONECLICK_API_KEY=

# Public WalletConnect client id from cloud.reown.com. Enables EVM wallet connect on mobile browsers.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
